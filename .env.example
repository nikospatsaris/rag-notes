# Pick ONE backend. Leave everything commented out to auto-detect:
# a running Ollama wins, then GEMINI_API_KEY, then ANTHROPIC_API_KEY.

# --- Free, no key at all. Needs Ollama running locally. ---
#   Install from https://ollama.com  then:  ollama pull llama3.2
# LLM_BACKEND=ollama
# OLLAMA_MODEL=llama3.2

# --- Free key. This is the one that works on Streamlit Cloud. ---
#   Get it at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Paid. ---
# ANTHROPIC_API_KEY=sk-ant-...
